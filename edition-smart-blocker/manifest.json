{
	"manifest_version": 3,
	"name": "Edition Smart Blocker",
	"version": "0.0.1",
	"description": "Blockiert bestimmte Elemente auf der Website derStandard.at.",
	"browser_specific_settings": {
		"gecko": {
			"id": "edition-smart-blocker@domain69.dev",
			"strict_min_version": "109.0",
			"data_collection_permissions": {
				"required": [
					"none"
				]
			}
		}
	},
	"content_scripts": [
		{
			"matches": [
				"https://www.derstandard.at/*"
			],
			"js": [
				"content.js"
			],
			"css": [
				"styles.css"
			],
			"run_at": "document_idle"
		}
	]
}